# ─────────────────────────────────────────────────────────────────
# Apex Dental Clinic — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Database (Required) ───────────────────────────────────────────
# Neon Postgres connection string — get it from console.neon.tech
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── JWT Authentication (Required) ────────────────────────────────
# Change this to a long, random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# ── App Environment ───────────────────────────────────────────────
NODE_ENV=development   # Set to "production" on Vercel

# ── Server Port (local dev only, Vercel ignores this) ─────────────
PORT=3000

# ── Vercel Deployment Notes ───────────────────────────────────────
# Add DATABASE_URL and JWT_SECRET to your Vercel project's
# Environment Variables at: vercel.com → Project → Settings → Environment Variables
# NODE_ENV is set automatically by Vercel to "production"
