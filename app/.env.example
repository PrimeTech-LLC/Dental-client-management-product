# ─────────────────────────────────────────────────────────────────────────────
# Apex Dental Clinic — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Required) ───────────────────────────────────────────────────────
# Neon Postgres pooler connection string.
# Get it from: console.neon.tech → your project → Connection Details → Pooled
# Use sslmode=require. The channel_binding=require parameter is supported by
# the @neondatabase/serverless HTTP driver used in this project.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require

# ── JWT Authentication (Required) ─────────────────────────────────────────────
# Change to a long random string in production.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# ── App Environment ───────────────────────────────────────────────────────────
NODE_ENV=development   # Set to "production" on Vercel / in prod builds

# ── Server Port (API — local dev only) ───────────────────────────────────────
# The Express API server listens on this port in dev.
# Vite dev server runs on port 3000 and proxies /api/* to this port.
PORT=3001              # Override to change API port; Vite proxy must match

# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT
# ─────────────────────────────────────────────────────────────────────────────
# Run two terminals:
#   Terminal 1 (API):      npm run dev:api    → http://localhost:3001
#   Terminal 2 (Frontend): npm run dev:ui     → http://localhost:3000
#
# Or use the combined command (requires concurrently):
#   npm run dev
#
# Open the app at: http://localhost:3000
#
# ─────────────────────────────────────────────────────────────────────────────
# DATABASE SETUP (first time only)
# ─────────────────────────────────────────────────────────────────────────────
#   npm run migrate:seed   → creates all tables and inserts demo data
#   npm run migrate        → creates tables only (no seed data)
#   npm run migrate:reset  → DROPS all tables, recreates, and re-seeds (dev only)
#
# ─────────────────────────────────────────────────────────────────────────────
# VERCEL DEPLOYMENT
# ─────────────────────────────────────────────────────────────────────────────
# 1. Add DATABASE_URL and JWT_SECRET to:
#    Vercel Dashboard → Project → Settings → Environment Variables
# 2. NODE_ENV is set to "production" automatically by Vercel.
# 3. Run: vercel deploy
#
# The production build serves static files from /dist directly via the
# Express server (no separate Vite process needed in production).
