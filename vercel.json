{
  "version": 2,
  "buildCommand": "npm install --prefix app && npm run build --prefix app",
  "outputDirectory": "app/dist",
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.js" }
  ]
}
